# ============================================================================
#  MAX Task Scheduler — пример переменных окружения
#  Скопируйте этот файл в .env  (cp env.example .env) и заполните значения.
#  Файл .env НИКОГДА не коммитится (см. .gitignore) и не попадает во frontend.
#
#  ВАЖНО: из-за защитных настроек среды файл-шаблон называется env.example
#  (без ведущей точки). При желании переименуйте его в .env.example:
#      mv env.example .env.example
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL (используется контейнером базы в docker-compose)
# ----------------------------------------------------------------------------
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=taskdb

# Строка подключения для backend.
# В docker-compose host = "db" (имя сервиса). Для локального Postgres: localhost.
DATABASE_URL=postgres://taskuser:change_me_please@db:5432/taskdb

# ----------------------------------------------------------------------------
# MAX Bot API
# ----------------------------------------------------------------------------
# Токен бота. Получается у @MasterBot в MAX при создании бота.
# ВСТАВЬТЕ СЮДА ВАШ ТОКЕН БОТА MAX:
MAX_BOT_TOKEN=

# Базовый URL Bot API MAX (менять обычно не нужно).
MAX_BOT_API_BASE=https://botapi.max.ru

# Юзернейм бота без @ (например, my_tasks_bot). Нужен для кнопки "Открыть приложение".
MAX_BOT_USERNAME=

# ----------------------------------------------------------------------------
# Роли / администратор
# ----------------------------------------------------------------------------
# MAX user ID единственного администратора. Этот пользователь автоматически
# получает роль ADMIN. Все остальные — USER. Роль нельзя изменить из frontend.
# Как узнать свой MAX ID: откройте Mini App — ваш ID показан на экране входа
# (или напишите боту /start — он пришлёт ваш ID, если включён polling).
ADMIN_MAX_USER_ID=

# ----------------------------------------------------------------------------
# Mini App
# ----------------------------------------------------------------------------
# Публичный HTTPS-URL, по которому открывается Mini App (указывается в настройках
# бота в MAX и используется в кнопке уведомления "Открыть приложение").
# Для локальной разработки можно оставить пустым.
MINI_APP_URL=

# Через запятую — разрешённые Origin для CORS (frontend). Для dev обычно:
# http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------------------
# Получение апдейтов ботом
# ----------------------------------------------------------------------------
# polling  — backend сам опрашивает GET /updates (по умолчанию, не нужен публичный URL)
# webhook  — MAX шлёт события на WEBHOOK_URL (нужен публичный HTTPS)
# off      — бот не слушает апдейты (только отправка уведомлений)
BOT_UPDATES_MODE=polling

# Только для webhook-режима:
WEBHOOK_URL=
WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Безопасность авторизации MAX
# ----------------------------------------------------------------------------
# Максимальный возраст initData (сек). Старее — отклоняется (защита от replay).
# 0 — проверку возраста отключить (не рекомендуется для прода).
INIT_DATA_MAX_AGE_SECONDS=86400

# ----------------------------------------------------------------------------
# Еженедельный отчёт
# ----------------------------------------------------------------------------
# Часовой пояс приложения (IANA), например Europe/Moscow.
APP_TIMEZONE=Europe/Moscow

# CRON расписания отчёта (по умолчанию: понедельник 09:00 в APP_TIMEZONE).
WEEKLY_REPORT_CRON=0 9 * * 1

# ----------------------------------------------------------------------------
# Сервер
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=8080

# ----------------------------------------------------------------------------
# Продакшен (docker-compose.prod.yml, автоматический HTTPS через Caddy)
# ----------------------------------------------------------------------------
# Домен, на котором будет жить Mini App (A-запись должна указывать на ваш сервер).
DOMAIN=
# Email для Let's Encrypt (уведомления о сертификате).
ACME_EMAIL=

